# ============================================================
# knowledge-brain 环境配置模板
# 复制为 .env 后填入真实值。切勿提交 .env（已在 .gitignore）
# ============================================================

# ---------- 数据库 ----------
# 必须使用带 pgvector + zhparser 的 PG（见 docker/README.md）：
#   docker compose up -d postgres
#
# ⚠️ DATABASE_URL 必须用非特权角色 kb_app。
# RLS 对 superuser 恒不生效，对表 owner 默认也不生效；用 owner 连接
# 等于把租户隔离整个关掉（spec §5 ②）。settings 会在启动时校验这一点。
DATABASE_URL=postgresql+asyncpg://kb_app:kb_app_pw@localhost:5432/kb
# owner/管理员连接：仅用于全量重建、测试 fixture、运维 CLI
DATABASE_URL_ADMIN=postgresql+asyncpg://kb:kb@localhost:5432/kb
# Alembic 走同步驱动（psycopg2），需要 DDL 权限，因此同样是 owner 角色
DATABASE_URL_SYNC=postgresql://kb:kb@localhost:5432/kb

# ---------- 数据库容器（docker compose 读取，可覆盖）----------
POSTGRES_USER=kb
POSTGRES_PASSWORD=kb
POSTGRES_DB=kb
POSTGRES_PORT=5432
# 首次初始化时赋给 kb_app 角色的密码；仅本地开发用
KB_APP_PASSWORD=kb_app_pw

# ---------- API / MCP ----------
API_HOST=0.0.0.0
API_PORT=8000
# 生产必须 HTTPS —— bearer token 走明文 HTTP 等于公开知识库
PUBLIC_BASE_URL=https://kb.example.com

# ---------- Embedding Provider ----------
# provider 可插拔；第一期用云 API
# 当前实测部署：阿里云百炼 Model Studio 的 OpenAI 兼容模式
#   · qwen3.7-text-embedding-flash 维度上限 1024（可选 1024/768/512/256），
#     请求不支持的维度时不报错，而是静默返回 1024 维 —— 所以 dimensions 必须显式传
#   · 单请求批次真实上限 25 条（官方文档写 20），此处取 20 留余量
# EMBEDDING_DIM 必须与 chunks.embedding 的列宽一致，改它要配套一次迁移 + 全量重建
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=20
EMBEDDING_MAX_CONCURRENCY=8

# Query embedding 缓存（进程内 LRU）
QUERY_CACHE_SIZE=1024

# ---------- 队列 ----------
QUEUE_LOCK_TIMEOUT_SECONDS=900
QUEUE_MAX_ATTEMPTS=5

# ---------- 同步 ----------
SYNC_POLL_INTERVAL_SECONDS=300
SYNC_BATCH_SIZE=500
MAX_FILE_SIZE_BYTES=52428800

# ---------- 检索 ----------
RETRIEVAL_DEFAULT_LIMIT=25
RETRIEVAL_MAX_LIMIT=50
RRF_K=60
PER_DOCUMENT_CHUNK_LIMIT=3

# ---------- 分块 ----------
CHUNKER_VERSION=1
CHUNK_MIN_TOKENS=120
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_RATIO=0.15
EMBED_SKIP_MIN_TOKENS=10
EMBED_SKIP_MAX_TOKENS=8000

# ---------- 存储 ----------
# bare partial clone 的落地目录，按 repo id 分子目录。纯 scratch，丢了会重新拉。
GIT_WORKDIR_ROOT=var/git
# 手动上传的原始文件。spec §7 约束 6 要求转换在服务端，所以原件必须留着 ——
# 换解析器时要能重转，而不是求用户重新上传。
BLOB_STORE_PATH=var/blobs

# ---------- Git 凭证 ----------
# 指向密钥存储的引用（**环境变量名**），明文绝不落库
GIT_CREDENTIAL_REF=
# 例：GIT_CREDENTIAL_REF=KB_VAULT_TOKEN，然后把 token 放在同名环境变量里

# ---------- 日志 ----------
LOG_LEVEL=INFO
